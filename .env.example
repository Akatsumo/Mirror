# Mirror bot environment. Empty values use defaults; most keys can also be edited live via /bsetting.
# Sizes accept 2GB / 1.5g; lists are space/comma separated; dicts are JSON.

# --- Telegram ---
API_ID=
API_HASH=
BOT_TOKEN=
SESSION_STRING=
OWNER_ID=
CMD_SUFFIX=

# --- Database ---
DATABASE_URL=
DATABASE_NAME=mirror

# --- Access ---
AUTHORIZED_CHATS=
SUDO_USERS=
FSUB_CHATS=

# --- Limits ---
MAX_USER_TASKS=
DIRECT_LIMIT=
TORRENT_LIMIT=
NZB_LIMIT=
YTDL_LIMIT=
GDRIVE_LIMIT=
CLONE_LIMIT=
LEECH_LIMIT=
STORAGE_THRESHOLD=
DAILY_QUOTA=
PLAYLIST_LIMIT=

# --- Queue ---
QUEUE_ALL=
QUEUE_DOWNLOAD=4
QUEUE_UPLOAD=4

# --- Status ---
STATUS_LIMIT=4
STATUS_UPDATE_INTERVAL=10

# --- Paths ---
DOWNLOAD_DIR=downloads
DATA_DIR=data

# --- Leech ---
LEECH_SPLIT_SIZE=
AS_DOCUMENT=
EQUAL_SPLITS=
MEDIA_GROUP=
LEECH_PREFIX=
LEECH_SUFFIX=
LEECH_REMNAME=
LEECH_DUMP_CHAT=
UPLOAD_SESSION=mix
THUMBNAIL_LAYOUT=
NAME_SUBSTITUTE=
EXCLUDED_EXTENSIONS=

# --- Upload ---
DEFAULT_UPLOAD=gd
STOP_DUPLICATE=
UPLOAD_PATHS=
USER_CREDS=

# --- GDrive ---
GDRIVE_ID=
IS_TEAM_DRIVE=
USE_SERVICE_ACCOUNTS=
INDEX_URL=
DRIVES=

# --- Rclone ---
RCLONE_PATH=
RCLONE_FLAGS=
RCLONE_SERVE_URL=
RCLONE_SERVE_PORT=
RCLONE_SERVE_USER=
RCLONE_SERVE_PASS=

# --- Torrent ---
TORRENT_ENGINE=qbit
DIRECT_ENGINE=aiohttp
TORRENT_TIMEOUT=
QBIT_HOST=http://localhost:8090
QBIT_USER=
QBIT_PASS=
ARIA2_HOST=http://localhost
ARIA2_PORT=6800
ARIA2_SECRET=
DEBRID_TOKEN=

# --- Usenet ---
SABNZBD_HOST=http://localhost:8070
SABNZBD_API_KEY=

# --- JDownloader ---
JD_EMAIL=
JD_PASS=
JD_DEVICE=mirror

# --- Extractors ---
YT_DLP_OPTIONS=
GALLERY_DL_OPTIONS=

# --- DDL ---
DDL_SITES=gofile
GOFILE_TOKEN=
STREAMTAPE_LOGIN=
STREAMTAPE_KEY=

# --- Resolvers ---
FILELION_API=
STREAMWISH_API=
TERABOX_COOKIE=

# --- Rss ---
RSS_CHAT=
RSS_INTERVAL=900

# --- Search ---
SEARCH_API_URL=
SEARCH_PLUGINS=
SEARCH_LIMIT=50

# --- Misc ---
RESTORE_TASKS=true
LOG_LEVEL=INFO
UPSTREAM_REPO=
UPSTREAM_BRANCH=main

# --- start.sh (single container) ---
START_LOCAL_ENGINES=0
QBIT_PORT=8090
